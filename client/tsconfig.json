{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@codex-app-server/*": [
        "../protocol/codex-app-server/0.157.1/typescript/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "expo-env.d.ts",
    "app.config.ts",
    ".expo/types/**/*.ts"
  ]
}
