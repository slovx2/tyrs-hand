{
  "cli": { "version": "16.28.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_TYRS_HAND_PREVIEW": "false" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_ENV": "preview", "EXPO_PUBLIC_TYRS_HAND_PREVIEW": "true" }
    },
    "adhoc": {
      "autoIncrement": true,
      "distribution": "internal",
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_TYRS_HAND_PREVIEW": "false" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_TYRS_HAND_PREVIEW": "false" }
    }
  }
}
