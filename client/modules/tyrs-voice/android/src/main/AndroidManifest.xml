<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name="com.tyrshand.voice.TyrsVoiceInteractionService"
      android:directBootAware="true"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_VOICE_INTERACTION">
      <intent-filter>
        <action android:name="android.service.voice.VoiceInteractionService" />
      </intent-filter>
      <meta-data
        android:name="android.voice_interaction"
        android:resource="@xml/tyrs_voice_interaction" />
    </service>
    <service
      android:name="com.tyrshand.voice.TyrsRecognitionService"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
      <intent-filter>
        <action android:name="android.speech.RecognitionService" />
      </intent-filter>
    </service>
    <service
      android:name="com.tyrshand.voice.TyrsVoiceInteractionSessionService"
      android:directBootAware="true"
      android:exported="true"
      android:label="@string/app_name"
      android:permission="android.permission.BIND_VOICE_INTERACTION"
      android:process=":voice" />
  </application>
</manifest>
