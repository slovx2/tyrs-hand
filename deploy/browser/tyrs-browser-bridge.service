[Unit]
Description=Tyrs Browser Bridge
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/tyrs-hand/browser/releases/current/tyrs-browser-bridge
EnvironmentFile=/opt/tyrs-hand/browser/browser.env
ExecStart=/usr/local/bin/node /opt/tyrs-hand/browser/releases/current/tyrs-browser-bridge/bridge/src/server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
# Ubuntu 会把用户级服务的挂载命名空间切到 unprivileged_userns AppArmor
# profile，继而拒绝连接从开发容器 bind mount 出来的服务代理 Unix Socket。

[Install]
WantedBy=graphical-session.target
