[Unit]
Description=Tyrs Hand host worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@WORKER_USER@
EnvironmentFile=-/etc/tyrs-hand/codex.env
EnvironmentFile=/etc/tyrs-hand/worker.env
ExecStart=/usr/local/bin/tyrs-hand-worker
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=15s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
