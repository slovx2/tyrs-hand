TYRS_HAND_ENV=production
TYRS_HAND_WORKER_CONTROL_URL=https://tyr.example.com
# 设为 true 后停止心跳、任务领取、配置通道和状态上报；本地 SSH 与 Codex 继续可用。
# TYRS_HAND_WORKER_DISABLE_CONTROL_SYNC=true
# 控制通道就绪时按唤醒事件拉取待办，以下间隔只作为唤醒丢失时的兜底扫描。
# TYRS_HAND_NODE_HEARTBEAT_INTERVAL=60s
# TYRS_HAND_WORKER_CLAIM_FALLBACK_INTERVAL=60s
# TYRS_HAND_WORKER_SYNC_FALLBACK_INTERVAL=5m
TYRS_HAND_WORKER_ID=worker-hostname
TYRS_HAND_WORKER_ROLE=all
TYRS_HAND_WORKER_MAX_CONCURRENT_JOBS=6
TYRS_HAND_WORKER_ENROLLMENT_TOKEN=
TYRS_HAND_WORKER_PROTOCOL_VERSION=32
TYRS_HAND_CODEX_BIN=/usr/local/bin/codex
TYRS_HAND_WORKER_HOME=/home/worker
TYRS_HAND_WORKER_CODEX_HOME=/home/worker/.codex
TYRS_HAND_WORKER_SHELL=/bin/bash
TYRS_HAND_WORKER_WORKSPACE_ROOT=/home/worker/tyrs-hand/workspaces
TYRS_HAND_WORKER_AUTHORIZED_KEYS_FILE=/home/worker/.local/share/tyrs-hand/worker/ssh/authorized_keys
# Provider 配置由 Control 写入全局 Worker 环境；不要手工提交真实 API Key。
# TYRS_HAND_MODEL_BASE_URL=https://api.example.com/v1
# TYRS_HAND_MODEL_API_KEY=replace-me
TYRS_HAND_WORKER_SSH_LISTEN_ADDR=:2222
TYRS_HAND_BROWSER_MCP_URL=
TYRS_HAND_BROWSER_MCP_TOKEN_FILE=/home/worker/.local/share/tyrs-hand/browser/token
TYRS_HAND_BROWSER_AGENT_ADDRESS=127.0.0.1:8934
TYRS_HAND_BROWSER_FILES_ROOT=/home/worker/.local/share/tyrs-hand/browser/files
TYRS_HAND_BROWSER_SERVICES_ROOT=/opt/tyrs-hand/browser-services
