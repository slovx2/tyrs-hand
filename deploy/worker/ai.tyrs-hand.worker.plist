<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.tyrs-hand.worker</string>
  <key>UserName</key><string>@WORKER_USER@</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/libexec/tyrs-hand-worker-run</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/tyrs-hand-worker.log</string>
  <key>StandardErrorPath</key><string>/var/log/tyrs-hand-worker.log</string>
</dict>
</plist>
