{
  "method": "runtime/info",
  "kind": "ClientRequest",
  "params": { "type": "object", "additionalProperties": false },
  "response": {
    "type": "object",
    "required": ["engine", "protocolVersion", "cliBuild", "capabilities", "releaseReady"],
    "properties": {
      "engine": { "enum": ["codex", "claude-code", "pi"] },
      "protocolVersion": { "const": "0.157.1" },
      "cliBuild": { "type": "string", "minLength": 1 },
      "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "releaseReady": { "type": "boolean" },
      "workerId": { "type": "string", "minLength": 1 },
      "status": { "enum": ["running", "unavailable", "stopped"] },
      "nodeVersion": { "const": "24.14.0" },
      "sdkVersion": { "enum": ["0.3.282", "0.99.1"] },
      "pluginVersions": {
        "type": "object",
        "required": ["@narumitw/pi-plan-mode", "@narumitw/pi-tui-kit", "@gotgenes/pi-subagents"],
        "properties": {
          "@narumitw/pi-plan-mode": { "const": "0.58.3" },
          "@narumitw/pi-tui-kit": { "const": "0.59.0" },
          "@gotgenes/pi-subagents": { "const": "21.8.1" }
        },
        "additionalProperties": false
      },
      "cliSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "oneOf": [
      { "properties": { "engine": { "const": "codex" } }, "required": ["workerId", "status"] },
      { "properties": { "engine": { "const": "claude-code" }, "sdkVersion": { "const": "0.3.282" } }, "required": ["nodeVersion", "sdkVersion", "cliSha256"] },
      { "properties": { "engine": { "const": "pi" }, "sdkVersion": { "const": "0.99.1" }, "cliBuild": { "const": "0.99.1" } }, "required": ["nodeVersion", "sdkVersion", "pluginVersions"] }
    ],
    "additionalProperties": false
  }
}
